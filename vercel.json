{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?__path=/api/:match*"
    },
    {
      "source": "/(HealthReport_.*\\.html)",
      "destination": "/api/index.py?__path=/api/reports/html/$1"
    },
    {
      "source": "/(BatteryReport_.*\\.html)",
      "destination": "/api/index.py?__path=/api/reports/html/$1"
    },
    {
      "source": "/",
      "destination": "/Dashboard.html"
    }
  ]
}
