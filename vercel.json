{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "Dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/Dashboard.html",
      "dest": "/Dashboard.html"
    },
    {
      "src": "/",
      "dest": "/Dashboard.html"
    }
  ]
}
